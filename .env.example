# Base de datos (Neon). Vercel la agrega sola al conectar Neon desde Storage.
# Sin ella: en desarrollo se usa una base local de pruebas (.pglite/) y en
# produccion la tienda lee data/catalogo.json y el panel no guarda.
DATABASE_URL=

# Fotos que sube el panel (Vercel Blob). Vercel la agrega sola al crear el Blob store.
BLOB_READ_WRITE_TOKEN=

# Contrasena del panel /admin. Sin ella el panel responde 404.
ADMIN_CLAVE=

# WhatsApp del negocio, con lada de pais y sin signos: 52 + 10 digitos
NEXT_PUBLIC_WA_NUMERO=5215512345678

# Mercado Pago — Fase 5, dejar vacio por ahora
MP_ACCESS_TOKEN=
NEXT_PUBLIC_MP_PUBLIC_KEY=

# Dominio publico. Al conectar rossylady.com: https://rossylady.com
NEXT_PUBLIC_SITE_URL=
